        "reason": "internal plan or mandate reference"
      },
      "REV": {
        "source": "\\b(?:[a-z]*[0-9])?rev ?[0-9]+\\b",
        "reason": "internal contract revision reference",
        "allowLineRe": [
          "[Rr]evision.*\\brev0\\b|\\brev0\\b.*[Rr]evision",
          "strictEqual\\(rev0,"
        ]
      },
      "SECTION": {
        "source": "\\b(?:contratto|piano|spec|specifica|design|documento)\\b[^.\\n§]{0,30}§[0-9]+(?:\\.[0-9]+)?[a-z]?",
        "reason": "internal document section reference"
      },
      "PROVENANCE": {
        "source": "\\b(?:[Rr]e-?)?[Aa]udit(?:or)?\\b[^\\n]{0,40}?\\b(?=[0-9a-f]{7,40}\\b)(?=[0-9a-f]*[0-9])[0-9a-f]{7,40}\\b|\\b[Pp]iano\\s+(?:v[0-9]+|[A-Z]?[0-9]+)\\b|\\b(?:[Pp]iano|[Rr]evisione|[Cc]ontratto|rev ?[0-9]+)\\b[^\\n]{0,40}?\\s:[0-9]{1,5}(?:-[0-9]{1,5})?\\b",
        "flags": "i",
        "reason": "internal audit hash or plan reference (never exempt)"
      },
      "LOWERCASE_ID": {
        "source": "(?<![a-z0-9])(?:(?:nc|sentinella)[-_]?d[0-9]{1,4}|(?:[a-z0-9]+-)+d[0-9]{3,4})[a-z0-9_-]*",
        "flags": "i",
        "reason": "internal work-order code in a fixture or file name"
      }
    },
    "denyToken": [],
    "allowToken": [],
    "allowTokenRe": [],
    "allowLineRe": [],
    "allowPathPrefix": [
      "package-lock.json",
      "frontend/package-lock.json",
      "frontend/dist/"
    ],
    "note": "Blocks what identifies work orders, audit provenance and internal plans (D-nnn, Dnnn, V-nn, audit/auditor, plan and revision references, sections cited with a document name). Short specification labels such as R25 or IC1.1 are public since 0.9.61 and are allowed. Any match of a family fails closed unless an allow rule names it. Lock files are exempt because their integrity hashes contain random fragments. The PROVENANCE family (an audit followed by a hash, a numbered plan, plan or revision line references) carries no allow rule of any kind and is checked on every file that is scanned; the AUDIT family exemptions are limited to the files and lines that legitimately talk about audits. PROVENANCE is case-insensitive (upper-case words and upper-case hexadecimal digits are the same reference)."
  }
}
