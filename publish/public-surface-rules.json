{
  "version": 1,
  "text": [
    {
      "source": "NEEDS_CHANGES|\\bBLOCKER\\b|\\bAPPROVE\\b|merge-feature-register",
      "flags": "",
      "reason": "internal review marker"
    },
    {
      "source": "Co-Authored-By|Generated with \\[?Claude",
      "flags": "i",
      "reason": "internal attribution"
    },
    {
      "source": "(?:/home/dag/|~/Dev/[0-9]+_)",
      "flags": "i",
      "reason": "private workspace path"
    },
    {
      "source": "\\b(?:vps3|macair|pixel9pro|mgm)\\b",
      "flags": "i",
      "reason": "internal node hostname"
    },
    {
      "source": "\\bVPS[_-]?Cloud\\b",
      "flags": "i",
      "reason": "internal node name"
    },
    {
      "source": "\\b(?:AsusRP3|NovaLnx|SamWork|NotPg|SmartYeni|Pixel9Pro|MacAir|VPSCloud)\\b",
      "flags": "i",
      "reason": "internal node name"
    },
    {
      "source": "\\b(?:browserai|devworkerp|devworkera|devworker|devauditor|forkauditor|warmaster|gameauditor|gamedev|designcreator|elnino)\\b",
      "flags": "i",
      "reason": "internal fleet cell name"
    },
    {
      "source": "\\bNC_(?!(?:SUPERVISOR_OPT|SEND|TELE_SESSIONE)\\b)[A-Z0-9][A-Z0-9_]*\\b",
      "flags": "",
      "reason": "internal work-order code"
    },
    {
      "source": "\\b(?:F\\d+|D\\d+)\\b[^.\\n]{0,40}\\b(?:re)?audit\\b|\\b(?:re)?audit\\b[^.\\n]{0,40}\\b(?:F\\d+|D\\d+)\\b",
      "flags": "",
      "reason": "internal finding id paired with audit provenance"
    }
  ],
  "path": [
    {
      "source": "(?:^|/)(?:publish|published-tree|extract-payload-context)",
      "flags": "i",
      "reason": "internal publication guard/helper"
    },
    {
      "source": "(?:^|/)(?:CURRENT_STATE|test-report|superpowers)(?:/|$)",
      "flags": "i",
      "reason": "internal work document path"
    }
  ],
  "workcodes": {
    "families": {
      "ID": {
        "source": "\\b(?:D-[0-9]{1,4}|D[0-9]{3,4}|V-[0-9]{1,3}|NC-[A-Z][0-9]*)\\b",
        "reason": "internal work-order code"
      },
      "AUDIT": {
        "source": "\\b(?:(?:[Rr]e-?)?[Aa]udit(?:or)?|AUDIT(?:OR)?)\\b",
        "reason": "internal audit provenance",
        "allowPathPrefix": [
          "skills/",
          "CHANGELOG.md",
          "README.md",
          "tests/auditor-",
          "frontend/src/components/AuditorF32"
        ],
        "allowLineRe": [
          "--no-audit",
          "dependency audit",
          "npm audit",
          "audit trail",
          "Audit mobile and desktop",
          "Claude Auditor",
          "cloud-Auditor",
          "cell: 'Auditor'",
          "sei un auditor",
          "lease-audit-2a-fixes"
        ]
      },
      "PLAN": {
        "source": "\\b(?:[Cc]ome da|[Ss]econdo il|[Dd]al|[Dd]el|[Nn]el|[Dd]allo) (?:piano|mandato)\\b(?: [A-Z][0-9][0-9a-z.]*)?|\\b[Pp]iano [A-Z][0-9]\\b",
        "reason": "internal plan or mandate reference"
      },
      "REV": {
        "source": "\\b(?:[a-z]*[0-9])?rev ?[0-9]+\\b",
        "reason": "internal contract revision reference",
        "allowLineRe": [
          "[Rr]evision.*\\brev0\\b|\\brev0\\b.*[Rr]evision",
          "strictEqual\\(rev0,"
        ]
      },
      "SECTION": {
        "source": "\\b(?:contratto|piano|spec|specifica|design|documento)\\b[^.\\n§]{0,30}§[0-9]+(?:\\.[0-9]+)?[a-z]?",
        "reason": "internal document section reference"
      }
    },
    "denyToken": [],
    "allowToken": [],
    "allowTokenRe": [],
    "allowLineRe": [],
    "allowPathPrefix": [
      "package-lock.json",
      "frontend/package-lock.json",
      "frontend/dist/"
    ],
    "note": "Blocks what identifies work orders, audit provenance and internal plans (D-nnn, Dnnn, V-nn, audit/auditor, plan and revision references, sections cited with a document name). Short specification labels such as R25 or IC1.1 are public since 0.9.61 and are allowed. Any match of a family fails closed unless an allow rule names it. Lock files are exempt because their integrity hashes contain random fragments."
  }
}
